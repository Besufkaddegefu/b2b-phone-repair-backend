# Application
APP_NAME="B2B Phone Repair Marketplace"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret_here"
TELEGRAM_WEBHOOK_URL="https://your-domain.com/webhook/tg"

# Neon Database
DATABASE_URL="postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Clerk Authentication
CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
CLERK_WEBHOOK_SECRET="whsec_xxx"

# Payments - Chapa
CHAPA_SECRET_KEY="CHASECK_TEST_xxx"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST_xxx"
CHAPA_WEBHOOK_SECRET="chapa_webhook_secret"
CHAPA_BASE_URL="https://api.chapa.co/v1"

# Payments - Telebirr
TELEBIRR_APP_ID="your_app_id"
TELEBIRR_APP_KEY="your_app_key"
TELEBIRR_PUBLIC_KEY="your_public_key"
TELEBIRR_BASE_URL="https://api.telebirr.com"

# Payments - CBE Birr
CBE_WEBHOOK_SECRET="cbe_webhook_secret"

# Media Storage - Cloudflare R2 / S3
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="b2b-phone-repair-media"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# Admin
ADMIN_TELEGRAM_IDS="123456789,987654321"
ADMIN_CHANNEL_ID="-1001234567890"